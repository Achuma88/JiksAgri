@model IEnumerable<JiksAgriFarm.Data.Models.Domain.Farmer>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background-image: url("/images/bc437060-cdac-11ef-94cb-5f844ceb9e30.jpg");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        background-attachment: fixed;
    }

    .admin-overlay {
        min-height: 100vh;
        padding-top: 90px;
    }

    .navbar-admin {
        background-color: #0f5132;
    }

        .navbar-admin .nav-link,
        .navbar-admin .navbar-brand {
            color: white;
            font-weight: 500;
        }

            .navbar-admin .nav-link.active {
                text-decoration: underline;
            }

    .farmer-card {
        transition: transform 0.3s;
    }

        .farmer-card:hover {
            transform: translateY(-5px);
        }
</style>

<!-- 🔝 ADMIN NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-admin fixed-top shadow">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" asp-action="Index">JiksAgriFarm</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-action="Dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" asp-action="DisplayAll">Farmers</a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        👤 Admin
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-action="Profile">My Profile</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item text-danger" asp-action="Logout">Sign Out</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- 🧾 PAGE CONTENT -->
<div class="admin-overlay">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
        }

        <h4 class="fw-bold mt-4 mb-3">Registered Farmers</h4>

        <div class="row mb-3">
            <div class="col-md-6">
                <input id="farmerSearch" class="form-control"
                       placeholder="Search farmers..." />
            </div>
        </div>

        <!-- FARMERS GRID -->
        <div class="row">
            @foreach (var farmer in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4 farmer-card">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold">@farmer.FarmerName</h5>
                            <p><strong>Farm:</strong> @farmer.FarmName</p>
                            <p><strong>Phone:</strong> @farmer.FarmerPhone</p>
                            <p><strong>Email:</strong> @farmer.FarmerEmail</p>
                            <p><strong>Location:</strong> @farmer.FarmerLocation</p>

                            <span class="badge
                                    @(farmer.FarmerStatus == "Active" ? "bg-success" :
                                                                    farmer.FarmerStatus == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                            @farmer.FarmerStatus
                        </span>
                    </div>

                        <div class="card-footer bg-transparent d-flex justify-content-between">
                            <a asp-action="Details"
                               asp-route-id="@farmer.FarmerID"
                               class="btn btn-sm btn-outline-primary">
                                View
                            </a>

                        @if (!farmer.IsVerified)
                            {
                                <a asp-action="ApproveFarmer"
                                   asp-route-id="@farmer.FarmerID"
                                   class="btn btn-sm btn-outline-success">
                                    Verify
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById("farmerSearch").addEventListener("keyup", function () {
        let value = this.value.toLowerCase();
        document.querySelectorAll(".farmer-card").forEach(card => {
            card.style.display = card.innerText.toLowerCase().includes(value) ? "" : "none";
        });
    });
</script>
