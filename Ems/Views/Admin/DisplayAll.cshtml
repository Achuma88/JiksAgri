@model IEnumerable<JiksAgriFarm.Data.Models.Domain.Farmer>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    /* ================= PAGE BACKGROUND ================= */
    body {
        background-image: url("/images/bc437060-cdac-11ef-94cb-5f844ceb9e30.jpg");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        background-attachment: fixed;
    }

    .admin-overlay {
        min-height: 100vh;
        padding-top: 100px;
    }

    /* ================= CLEAN ADMIN NAVBAR ================= */
    .admin-navbar {
        background: rgba(15, 81, 50, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .admin-navbar .navbar-brand {
        font-weight: 700;
        color: green;
        letter-spacing: 0.5px;
    }

    .admin-navbar .nav-link {
        color: green !important;
        font-weight: 500;
        padding: 8px 14px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .admin-navbar .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.15);
        color: #fff !important;
    }

    .admin-navbar .nav-link.active {
        background-color: #ffffff;
        color: #0f5132 !important;
        font-weight: 600;
    }

    .admin-badge {
        background-color: #198754;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #fff;
    }

    /* ================= FARMER CARDS ================= */
    .farmer-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .farmer-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    }

    .card {
        border-radius: 16px;
    }

    .card-footer {
        border-top: none;
    }
    /* Center navbar links properly */
    .navbar-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
    }

        .navbar-center .nav-link {
            margin: 0 6px;
        }


</style>

<!-- ================= ADMIN NAVBAR ================= -->
<nav class="navbar navbar-expand-lg admin-navbar fixed-top shadow-sm">
    <div class="container-fluid px-4 position-relative">

        <a class="navbar-brand" asp-action="Dashboard">
            JiksAgriFarm
        </a>

        <button class="navbar-toggler text-white" type="button"
                data-bs-toggle="collapse" data-bs-target="#adminNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="adminNavbar">

            <!-- CENTER LINKS -->
            <ul class="navbar-nav navbar-center">
                <li class="nav-item">
                    <a class="nav-link active" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="Dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Farmer" asp-action="Add">Regist a farmer</a>
                </li>
            </ul>

            <!-- RIGHT SIDE -->
            <ul class="navbar-nav ms-auto align-items-center gap-3">
                <li class="nav-item">
                    <span class="admin-badge">Admin</span>
                </li>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        Account
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <a class="dropdown-item" asp-action="Profile">My Profile</a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item text-danger" asp-action="Logout">Sign Out</a>
                        </li>
                    </ul>
                </li>
            </ul>

        </div>
    </div>
</nav>


<!-- ================= PAGE CONTENT ================= -->
<div class="admin-overlay">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
        }

        <h4 class="fw-bold mb-3 text-white">Registered Farmers</h4>

        <div class="row mb-4">
            <div class="col-md-6">
                <input id="farmerSearch" class="form-control"
                       placeholder="Search farmers..." />
            </div>
        </div>

        <!-- FARMERS GRID -->
        <div class="row">
            @foreach (var farmer in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4 farmer-card">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold">@farmer.FarmerName</h5>
                            <p><strong>Farm:</strong> @farmer.FarmName</p>
                            <p><strong>Phone:</strong> @farmer.FarmerPhone</p>
                            <p><strong>Email:</strong> @farmer.FarmerEmail</p>
                            <p><strong>Location:</strong> @farmer.FarmerLocation</p>

                            <span class="badge
                                @(farmer.FarmerStatus == "Active" ? "bg-success" :
                                  farmer.FarmerStatus == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                                @farmer.FarmerStatus
                            </span>
                        </div>

                        <div class="card-footer bg-transparent d-flex justify-content-between">
                            <a asp-action="Details"
                               asp-route-id="@farmer.FarmerID"
                               class="btn btn-sm btn-outline-primary">
                                View
                            </a>

                            @if (!farmer.IsVerified)
                            {
                                <a asp-action="ApproveFarmer"
                                   asp-route-id="@farmer.FarmerID"
                                   class="btn btn-sm btn-outline-success">
                                    Verify
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById("farmerSearch").addEventListener("keyup", function () {
        let value = this.value.toLowerCase();
        document.querySelectorAll(".farmer-card").forEach(card => {
            card.style.display = card.innerText.toLowerCase().includes(value) ? "" : "none";
        });
    });
</script>
