@model JiksAgriFarm.Data.Models.Domain.Farmer

@{
    ViewData["Title"] = "Farmer";
}

@section Styles {
    <style>
        /* ================= NAVBAR ================= */
        .farmer-navbar {
            background: linear-gradient(135deg, #2f6f3e, #6fa84f);
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            width:100%;
        }

            .farmer-navbar .navbar-brand,
            .farmer-navbar .nav-link {
                color: #fff !important;
                font-weight: 500;
            }

                .farmer-navbar .nav-link:hover {
                    opacity: 0.85;
                }

        .navbar-toggler {
            border-color: rgba(255,255,255,0.6);
        }

        /* ================= DASHBOARD CARDS ================= */
        .stat-card {
            border-radius: 16px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08);
            background: #fff;
        }

            .stat-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 30px rgba(0,0,0,0.15);
                background: linear-gradient(135deg, #2f6f3e, #6fa84f);
                color: white;
            }

                .stat-card:hover i {
                    color: #fff !important;
                }

            .stat-card h5 {
                font-weight: 600;
            }

        /* ================= UPDATE BOX ================= */
        .update-box {
            border-radius: 18px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            background: #fff;
        }

            .update-box textarea {
                border-radius: 12px;
                resize: none;
            }

        .update-item {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 10px;
        }
        .container-fluid{
            width:100%;
        }
    </style>
}

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg farmer-navbar mb-5">
    <div class="container-fluid px-6">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            🌾 JiksAgriFarm
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#farmerNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="farmerNav">
            <ul class="navbar-nav mx-auto gap-3">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Farmer" asp-action="Dashboard">Dashboard</a>
                </li>
            </ul>

            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- ================= DASHBOARD CARDS ================= -->
<div class="container">
    <div class="row g-4 mb-5">

        <!-- ADD LIVESTOCK -->
        <div class="col-md-4">
            <a asp-action="AddLivestock" class="text-decoration-none text-dark">
                <div class="stat-card p-4">
                    <i class="fas fa-cow fa-2x text-success"></i>
                    <h5 class="mt-3">Add Livestock</h5>
                    <p class="small text-muted">List cattle, goats, sheep & more</p>
                </div>
            </a>
        </div>

        <!-- MY LISTINGS -->
        <div class="col-md-4">
            <a asp-action="MyListings" class="text-decoration-none text-dark">
                <div class="stat-card p-4">
                    <i class="fas fa-box fa-2x text-success"></i>
                    <h5 class="mt-3">My Listings</h5>
                    <p class="small text-muted">Manage your products & livestock</p>
                </div>
            </a>
        </div>

        <!-- ORDERS -->
        <div class="col-md-4">
            <a asp-action="Orders" class="text-decoration-none text-dark">
                <div class="stat-card p-4">
                    <i class="fas fa-chart-line fa-2x text-success"></i>
                    <h5 class="mt-3">Orders</h5>
                    <p class="small text-muted">Track sales & performance</p>
                </div>
            </a>
        </div>

    </div>

    <!-- ================= FARM UPDATES ================= -->
    <h4 class="mb-3 fw-bold">📢 Farm Updates</h4>

    <div class="update-box p-4 mb-5">

        <form asp-action="PostUpdate" method="post">
            <textarea class="form-control mb-3"
                      name="Message"
                      rows="3"
                      placeholder="Share updates about upcoming harvests, new livestock, or availability..."></textarea>

            <button class="btn btn-success px-4">Post Update</button>
        </form>

        <hr />

        @* Enable later *@
        @*
        @foreach (var update in Model.Updates)
        {
            <div class="update-item">
                <p class="mb-1">@update.Message</p>
                <small class="text-muted">
                    <i class="fas fa-clock"></i>
                    @update.CreatedDate.ToString("dd MMM yyyy")
                </small>
            </div>
        }
        *@

    </div>
</div>
