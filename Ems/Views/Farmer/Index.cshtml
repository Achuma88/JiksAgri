@model JiksAgriFarm.Data.Models.Domain.Farmer

<style>
    /* DASHBOARD CARDS */
    .stat-card {
        border-radius: 16px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

        .stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
            background: linear-gradient(135deg, #2f6f3e, #6fa84f);
            color: white;
        }

            .stat-card:hover i {
                color: #fff !important;
            }

        .stat-card h5 {
            font-weight: 600;
        }

    /* UPDATE BOX */
    .update-box {
        border-radius: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

        .update-box textarea {
            border-radius: 12px;
            resize: none;
        }

    .update-item {
        background-color: #f8f9fa;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 10px;
    }
</style>

<div class="row g-4 mb-5">

    <!-- ADD LIVESTOCK -->
    <div class="col-md-4">
        <a asp-action="AddLivestock" class="text-decoration-none text-dark">
            <div class="stat-card p-4 bg-white">
                <i class="fas fa-cow fa-2x text-success"></i>
                <h5 class="mt-3">Add Livestock</h5>
                <p class="small text-muted">List cattle, goats, sheep & more</p>
            </div>
        </a>
    </div>

    <!-- MY LISTINGS -->
    <div class="col-md-4">
        <a asp-action="MyListings" class="text-decoration-none text-dark">
            <div class="stat-card p-4 bg-white">
                <i class="fas fa-box fa-2x text-success"></i>
                <h5 class="mt-3">My Listings</h5>
                <p class="small text-muted">Manage your products & livestock</p>
            </div>
        </a>
    </div>

    <!-- ORDERS -->
    <div class="col-md-4">
        <a asp-action="Orders" class="text-decoration-none text-dark">
            <div class="stat-card p-4 bg-white">
                <i class="fas fa-chart-line fa-2x text-success"></i>
                <h5 class="mt-3">Orders</h5>
                <p class="small text-muted">Track sales & performance</p>
            </div>
        </a>
    </div>

</div>

<!-- FARM UPDATES -->
<h4 class="mb-3 fw-bold">📢 Farm Updates</h4>

<div class="update-box bg-white p-4">

    <form asp-action="PostUpdate" method="post">
        <textarea class="form-control mb-3"
                  name="Message"
                  rows="3"
                  placeholder="Share updates about upcoming harvests, new livestock, or availability..."></textarea>

        <button class="btn btn-success px-4">Post Update</button>
    </form>

    <hr />

    @* Example updates display (enable later) *@
    @*
    @foreach (var update in Model.Updates)
    {
        <div class="update-item">
            <p class="mb-1">@update.Message</p>
            <small class="text-muted">
                <i class="fas fa-clock"></i>
                @update.CreatedDate.ToString("dd MMM yyyy")
            </small>
        </div>
    }
    *@

</div>
