@{
    ViewData["Title"] = "CustomerHome";

    var customerName = Context.Session.GetString("CustomerName");
    var customerSurname = Context.Session.GetString("CustomerSurname");
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["msg"]
    </div>
}

<style>
    body {
       background-color:lightblue;
    }

    /* NAVBAR */
    .navbar-brand {
        font-size: 1.5rem;
    }

    /* HERO */
    .hero {
        background-image: url("/images/bc437060-cdac-11ef-94cb-5f844ceb9e30.jpg");
        background-size: cover;
        background-position: center;
        height: 60vh;
        color: white;
        display: flex;
        align-items: center;
    }

    .hero-overlay {
        background: rgba(0,0,0,0.80);
        width: 100%;
        height: 70%;
        display: flex;
        align-items: center;
    }

    .hero h1 {
        font-size: 3.5rem;
        font-weight: bold;
    }

    /* FEATURE STRIP */
    .feature-strip {
        background-color: #2f6f3e;
        color: white;
        padding: 40px 0;
    }

        .feature-strip i {
            font-size: 2rem;
            margin-bottom: 10px;
        }

    /* IMAGE SIZING */
    .product-img,
    .livestock-img {
        height: 220px;
        object-fit: cover;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    /* CARDS */
    .product-card, .livestock-card {
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

        .product-card:hover,
        .livestock-card:hover {
            transform: translateY(-6px);
        }

    /* CATEGORY */
    .category-card {
        background-color: white;
        border-radius: 15px;
        padding: 30px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: 0.3s;
        font-weight: bold;
    }

        .category-card:hover {
            background-color: #2f6f3e;
            color: white;
        }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: #1f5f3a; /* dark green */
        border-radius: 50%;
        width: 45px;
        height: 45px;
        background-size: 60%;
    }



        .carousel-control-prev-icon:hover,
        .carousel-control-next-icon:hover {
            background-color: #2f6f3e;
        }


    /* SELLER CTA */
    .seller-cta {
        background: linear-gradient(135deg, #2f6f3e, #6fa84f);
        color: white;
        padding: 60px 20px;
        border-radius: 20px;
    }
   
</style>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            🌾 JiksAgriFarm
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Products" asp-action="Index">Products</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Livestock" asp-action="Index">Livestock</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Categories" asp-action="Index">Categories</a>
                </li>
            </ul>

            <ul class="navbar-nav">
                @if (!string.IsNullOrEmpty(customerName))
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                            👤 @customerName @customerSurname
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Customer" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders">
                                    My Orders
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Customer" asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Customer" asp-action="Register">Register</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- ================= HERO ================= -->
<section class="hero">
    <div class="hero-overlay">
        <div class="container text-center">
            @if (!string.IsNullOrEmpty(customerName))
            {
                <h1>Welcome, @customerName 👋</h1>
                <p class="lead mt-3">Buy fresh. Sell smart. Grow together.</p>
            }
            else
            {
                <h1>Buy Fresh. Sell Smart. Grow Together.</h1>
                <p class="lead mt-3">
                    Connecting farmers directly to buyers across South Africa
                </p>
            }

            <div class="mt-4">
                <a asp-controller="Products" asp-action="Index" class="btn btn-success btn-lg me-3">
                    Shop Products
                </a>
                <a asp-controller="Livestock" asp-action="Index" class="btn btn-outline-light btn-lg">
                    Browse Livestock
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ================= FEATURES ================= -->
<section class="feature-strip text-center">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <i class="fas fa-tractor"></i>
                <h5>Direct From Farmers</h5>
            </div>
            <div class="col-md-3">
                <i class="fas fa-cow"></i>
                <h5>Verified Livestock</h5>
            </div>
            <div class="col-md-3">
                <i class="fas fa-lock"></i>
                <h5>Secure Payments</h5>
            </div>
            <div class="col-md-3">
                <i class="fas fa-truck"></i>
                <h5>Nationwide Delivery</h5>
            </div>
        </div>
    </div>
</section>
<section class="container my-5">
    <h2 class="text-center mb-4">Shop by Category</h2>

    <div id="categoryCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            <!-- SLIDE 1 -->
            <div class="carousel-item active">
                <div class="row g-4 justify-content-center text-center">

                    <div class="col-md-2 col-6">
                        <a asp-controller="Categories" asp-action="Crops"
                           class="category-card d-block text-decoration-none">
                            🌽 Crops
                        </a>
                    </div>

                    <div class="col-md-2 col-6">
                        <a asp-controller="Categories" asp-action="Vegetable"
                           class="category-card d-block text-decoration-none">
                            🥬 Vegetables
                        </a>
                    </div>

                    <div class="col-md-2 col-6">
                        <a asp-controller="Categories" asp-action="Poultry"
                           class="category-card d-block text-decoration-none">
                            🐓 Poultry
                        </a>
                    </div>

                    <div class="col-md-2 col-6">
                        <a asp-controller="Categories" asp-action="Cattle"
                           class="category-card d-block text-decoration-none">
                            🐄 Cattle
                        </a>
                    </div>

                   

                </div>
            </div>

            <!-- SLIDE 2 -->
            <div class="carousel-item">
                <div class="row g-4 justify-content-center text-center">

                    <div class="col-md-2 col-6">
                        <a asp-controller="Categories" asp-action="Produce"
                           class="category-card d-block text-decoration-none">
                            🧺 Produce
                        </a>
                    </div>
                    <div class="col-md-2 col-6">
                        <a asp-controller="Categories" asp-action="Goats"
                           class="category-card d-block text-decoration-none">
                            🐐 Goats
                        </a>
                    </div>
                    <div class="col-md-2 col-6">
                        <a asp-controller="Categories" asp-action="Tools"
                           class="category-card d-block text-decoration-none">
                            🚜 Tools
                        </a>
                    </div>

                </div>
            </div>

        </div>

        <!-- CONTROLS -->
        <button class="carousel-control-prev" type="button"
                data-bs-target="#categoryCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button"
                data-bs-target="#categoryCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>

<section class="container my-5">
    <h2 class="text-center mb-4">🔥 Trending Farm Products</h2>

    <div id="productCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            <div class="carousel-item active">
                <div class="row g-4 justify-content-center">
                    <div class="col-md-3">
                        <div class="card product-card shadow-sm">
                            <img src="/images/maize.jpg" class="product-img">
                            <div class="card-body text-center">
                                <h5>Fresh Maize (50kg)</h5>
                                <p class="fw-bold text-success">R450</p>
                                <a href="#" class="btn btn-outline-success btn-sm">View</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card product-card shadow-sm">
                            <img src="/images/veg.jpg" class="product-img">
                            <div class="card-body text-center">
                                <h5>Vegetables</h5>
                                <p class="fw-bold text-success">R300</p>
                                <a href="#" class="btn btn-outline-success btn-sm">View</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="card product-card shadow-sm">
                            <img src="/images/dairy.jpg" class="product-img">
                            <div class="card-body text-center">
                                <h5>Dairy Products</h5>
                                <p class="fw-bold text-success">R200</p>
                                <a href="#" class="btn btn-outline-success btn-sm">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <div class="row g-4 justify-content-center">
                    <div class="col-md-3">
                        <div class="card product-card shadow-sm">
                            <img src="/images/meat.jpg" class="product-img">
                            <div class="card-body text-center">
                                <h5>Fresh Meat</h5>
                                <p class="fw-bold text-success">R650</p>
                                <a href="#" class="btn btn-outline-success btn-sm">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>
<section class="container my-5">
    <h2 class="text-center mb-4">🐄 Livestock Marketplace</h2>

    <div id="livestockCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            <div class="carousel-item active">
                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card livestock-card shadow">
                            <img src="/images/cows-nguni.jpg" class="livestock-img">
                            <div class="card-body">
                                <h5>Nguni Cow</h5>
                                <p>Age: 2 Years</p>
                                <p class="fw-bold text-success">R18,000</p>
                                <a href="#" class="btn btn-success btn-sm">View Farmer</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card livestock-card shadow">
                            <img src="/images/pigs.jpg" class="livestock-img">
                            <div class="card-body">
                                <h5>Pigs</h5>
                                <p>Age: 2 Years</p>
                                <p class="fw-bold text-success">R3,000</p>
                                <a href="#" class="btn btn-success btn-sm">View Farmer</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <div class="row g-4 justify-content-center">
                    <div class="col-md-4">
                        <div class="card livestock-card shadow">
                            <img src="/images/sheep.jpg" class="livestock-img">
                            <div class="card-body">
                                <h5>Sheep</h5>
                                <p>Age: 2 Years</p>
                                <p class="fw-bold text-success">R7,000</p>
                                <a href="#" class="btn btn-success btn-sm">View Farmer</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card livestock-card shadow">
                            <img src="/images/gt.png" class="livestock-img">
                            <div class="card-body">
                                <h5>Goats</h5>
                                <p>Age: 2 Years</p>
                                <p class="fw-bold text-success">R8,000</p>
                                <a href="#" class="btn btn-success btn-sm">View Farmer</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#livestockCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#livestockCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>

<!-- ================= SELLER CTA ================= -->
<section class="container my-5">
    <div class="seller-cta text-center">
        <h2>Sell Your Farm Products Online</h2>
        <p class="lead">Join thousands of farmers growing their income</p>
        <a asp-controller="Customer" asp-action="Register" class="btn btn-light btn-lg">
            Become a Seller
        </a>
    </div>
</section>
