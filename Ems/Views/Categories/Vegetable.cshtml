@{
    ViewData["Title"] = "Vegetables";
}
<style>
    .category-header {
        background: linear-gradient(135deg, #2f6f3e, #6fa84f);
        color: white;
        padding: 60px 20px;
        border-radius: 15px;
        margin-bottom: 40px;
        text-align: center;
    }

    .product-grid img {
        height: 220px;
        object-fit: cover;
        border-radius: 15px 15px 0 0;
    }

    .product-card {
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
        }
</style>
<div class="category-header">
    <h1>🥬 Fresh Vegetables</h1>
    <p>Healthy vegetables harvested daily</p>
</div>

<div class="container product-grid">
    <div class="row g-4">

        <div class="col-md-3">
            <div class="card product-card shadow-sm">
                <img src="/images/veg.jpg">
                <div class="card-body text-center">
                    <h5>Mixed Vegetables</h5>
                    <p class="fw-bold text-success">R300</p>
                    <a href="#" class="btn btn-outline-success btn-sm">View</a>
                </div>
            </div>
        </div>

    </div>
</div>

